---
// Shared head + chrome for every page, now built on @bundu/ui — Nyuchi's
// implementation of the Mzizi design system — instead of hand-rolled CSS
// custom properties. Brand color (gold, Nyuchi's own ecosystem mineral —
// not Bundu's copper) comes from the library's brand-nyuchi.css overlay;
// typography (Noto Serif / Noto Sans / JetBrains Mono, per Mzizi's own
// type tokens) is already what @bundu/ui's globals.css and tailwind-preset
// specify, so the Google Fonts link below still supplies the exact faces
// the library's `font-serif`/`font-sans`/`font-mono` utilities expect.
//
// This <style> block (only the bits Tailwind utilities don't cover) is
// `is:global`: Astro scopes a component's styles to elements *that
// component itself* renders, and content passed through `<slot />` from a
// page keeps that page's own scope, not this layout's — so a plain
// (non-global) style here would silently never match anything inside
// <main>, including every page's own headings, links, and cards.
import "../styles/global.css";
import MineralStrip from "@bundu/ui/MineralStrip.astro";
import SocialIcon from "@bundu/ui/SocialIcon.astro";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<!-- Sets the theme attribute the library's tokens.css keys off of
     ([data-theme="dark"]) before first paint, so there's no flash of the
     wrong theme. This app is dark-by-default with light only when the OS
     explicitly prefers it — @bundu/ui's tokens.css is the opposite
     polarity (bare :root = light, [data-theme="dark"] = dark), so this
     script is what preserves this app's existing default using the
     library's own supported toggle mechanism, rather than hand-copying
     hex values between the two conventions (tokens.css explicitly says
     not to hand-edit its values). Must run synchronously, before any
     render-blocking content, which is why it's first in <head>.

     Also listens for the preference changing while the tab stays open
     (e.g. the OS switching themes at sunset) -- the previous CSS-only
     `@media (prefers-color-scheme)` approach updated live for free;
     matching that with an attribute-based toggle needs this explicit
     listener, not just the one-time check above.

     No-JS fallback: without JavaScript this attribute never gets set, so
     visitors always get the library's light-mode default regardless of
     OS preference, rather than this app's intended dark-by-default. A
     `prefers-color-scheme` media query could restore that, but only by
     hand-copying tokens.css's dark hex values into this file, which is
     exactly what that file's own docstring says not to do. Accepted
     tradeoff: a static informational site with negligible no-JS traffic
     isn't worth reintroducing a second, driftable copy of the palette. -->
<script is:inline>
  const media = matchMedia("(prefers-color-scheme: light)");
  const applyTheme = () => {
    document.documentElement.dataset.theme = media.matches ? "light" : "dark";
  };
  applyTheme();
  media.addEventListener("change", applyTheme);
</script>
<title>{title}</title>
<meta name="description" content={description}>
<!-- Nyuchi's actual bee mark (nyuchi.com/icon-dark.png) — "Nyuchi" is Shona
     for "Bee". A single fixed favicon rather than a light/dark swap, since
     <link rel=icon media=...> support is inconsistent across browsers; the
     dark variant is self-contained (own near-black background) so it holds
     up in either browser chrome theme. -->
<link rel="icon" type="image/png" href="/icon-dark.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif:wght@500;600;700&family=Noto+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style is:global>
  /* Comfortable width on laptop/desktop — 760px (a single-column article
     measure) left this cramped on anything wider than a phone, with most
     of the viewport sitting empty on either side. Kept as a raw value
     here (rather than a Tailwind max-w-* utility) since it's this app's
     own reading-width choice, not a design-system constant. */
  .content-width { max-width: var(--content-width); }

  /* Skip link: off-screen until focused. Its focused position (8px, not
     0) and z-index clear the fixed left-edge MineralStrip (6px wide,
     z-50) below instead of sitting half-behind it. */
  .skip-link {
    position: absolute; left: -999px; top: 0; z-index: 60;
    background: var(--primary); color: var(--primary-foreground);
    padding: .6rem 1rem; border-radius: 0 0 8px 0;
    font-family: var(--font-mono); font-size: .82rem; text-decoration: none;
  }
  .skip-link:focus { left: 8px; }
</style>
</head>
<body class="bg-canvas text-foreground font-sans antialiased">
<a class="skip-link" href="#main">Skip to content</a>
<MineralStrip />
<header class="content-width mx-auto flex flex-wrap items-center justify-between gap-4 px-6 pt-6">
  <a class="flex flex-shrink-0 items-center gap-2 whitespace-nowrap font-serif text-base font-semibold text-foreground" href="/">
    <picture>
      <source srcset="/icon-light.png" media="(prefers-color-scheme: light)">
      <img src="/icon-dark.png" alt="" width="26" height="26" class="block rounded-md">
    </picture>
    Nyuchi MCP for YNAB
  </a>
  <nav aria-label="Primary" class="flex flex-wrap items-center gap-4 sm:gap-6 text-sm">
    <a class="text-muted-foreground hover:text-foreground transition-colors" href="/project">Project</a>
    <a class="text-muted-foreground hover:text-foreground transition-colors" href="/status">Status</a>
    <a class="text-muted-foreground hover:text-foreground transition-colors" href="/privacy-policy">Privacy</a>
    <a class="text-muted-foreground hover:text-foreground transition-colors" href="https://nyuchi.com" target="_blank" rel="noopener">nyuchi.com</a>
    <SocialIcon url="https://github.com/bryanfawcett/mcp-ynab" label="GitHub repository" />
  </nav>
</header>
<main id="main" class="content-width mx-auto px-6 pb-20 pt-16">
  <slot />
</main>
<footer class="content-width mx-auto flex flex-wrap items-center justify-between gap-4 px-6 pb-12 pt-7 text-sm text-muted-foreground">
  <span>&copy; 2026 Nyuchi Africa. Part of the Bundu Foundation. Independent, unofficial — not affiliated with or endorsed by YNAB.</span>
  <nav aria-label="Footer" class="flex gap-5">
    <a class="hover:text-foreground transition-colors" href="https://github.com/bryanfawcett/mcp-ynab" target="_blank" rel="noopener">GitHub</a>
    <a class="hover:text-foreground transition-colors" href="/project">Project</a>
    <a class="hover:text-foreground transition-colors" href="/status">Status</a>
    <a class="hover:text-foreground transition-colors" href="/privacy-policy">Privacy Policy</a>
  </nav>
</footer>
<script>
  // Intercom Messenger — support widget, loaded on every page. Standard
  // async install snippet (intercom.com/help/en/articles/6205786): defines
  // a queued `window.Intercom` stub immediately so any call made before the
  // real script loads (there are none here, but a future page might) isn't
  // lost, then lazy-loads the actual widget script after the page finishes
  // loading rather than blocking on it. Unrelated to the MCP/YNAB data path
  // — this only ever sees site-visitor/support-chat data, never budget data
  // (see the Privacy Policy's "Support chat" section).
  window.intercomSettings = { api_base: "https://api-iam.intercom.io", app_id: "f1vga504" };
  (function () {
    var w = window as any;
    var ic = w.Intercom;
    if (typeof ic === "function") {
      ic("reattach_activator");
      ic("update", w.intercomSettings);
    } else {
      var d = document;
      var i: any = function () { i.c(arguments); };
      i.q = [];
      i.c = function (args: unknown) { i.q.push(args); };
      w.Intercom = i;
      var load = function () {
        var s = d.createElement("script");
        s.type = "text/javascript";
        s.async = true;
        s.src = "https://widget.intercom.io/widget/f1vga504";
        var x = d.getElementsByTagName("script")[0];
        x.parentNode!.insertBefore(s, x);
      };
      if (document.readyState === "complete") load();
      else w.addEventListener("load", load, false);
    }
  })();
</script>
</body>
</html>
