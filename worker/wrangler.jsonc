{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mcp-ynab",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // The Dockerfile lives inside this directory (Cloudflare's Workers Builds
  // git-integration requires the Wrangler config and Dockerfile to both be
  // under the configured root directory — see README.md), but its COPY paths
  // (pyproject.toml, uv.lock, src/, README.md) are repo-root-relative, so the
  // build context is set to the repo root via image_build_context.
  "containers": [
    {
      "class_name": "YnabMcpContainer",
      "image": "./Dockerfile",
      "image_build_context": "..",
      // 1 is correct for single-tenant mode (one account, one container). In
      // multi-tenant mode, src/index.ts routes each caller to their own
      // container instance (keyed by their YNAB token) so tenants don't share
      // CPU/memory/cache and each sleeps independently — that needs room for
      // more than one to run at once. 30 gives headroom for ~25 concurrent
      // users without every one of them needing to be simultaneously active
      // (idle ones still sleep per `sleepAfter` below, and Cloudflare's
      // active-CPU pricing only bills used CPU). This is deploy-time config
      // Wrangler pushes straight to Cloudflare's container API — our own
      // Worker code never reads it, so it can't be sourced from a runtime
      // env var; raise it here (and redeploy) if usage grows past this.
      "max_instances": 30
    }
  ],
  "durable_objects": {
    "bindings": [{ "class_name": "YnabMcpContainer", "name": "YNAB_MCP_CONTAINER" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["YnabMcpContainer"] }],

  // Plain vars, not secrets: neither value is a credential (an OAuth client
  // ID is meant to be public — it's exposed in the browser's redirect URL on
  // every authorize request regardless; an account ID is just an identifier,
  // same reasoning as OAUTH_KV_NAMESPACE_ID being a literal in index.ts).
  // Putting them here instead of behind `wrangler secret put`/`versions
  // secret put` means every deploy path (a plain `wrangler deploy`, a
  // gradual `versions upload`+`deploy`, or Workers Builds) carries them
  // automatically since they're part of source control — no more silent
  // loss from a deploy that clones the wrong "latest version" lineage,
  // which is what kept wiping them when they lived as versioned secrets.
  // The real credential, YNAB_OAUTH_CLIENT_SECRET, stays a secret.
  "vars": {
    "CLOUDFLARE_ACCOUNT_ID": "125a2dfbc21f76a25c980609609e8218",
    "YNAB_OAUTH_CLIENT_ID": "5eynM1IcwPgPZH-Rc9SS4FyvY3h8Nc7ViXJnb5mMTVY"
  },

  // Protects the container from a single caller hammering /mcp — keyed per
  // caller (a hash of their presented token, same as the per-tenant container
  // routing below) rather than per-IP, so one misbehaving tenant can't burn
  // through another's quota and legitimate shared-IP traffic isn't punished.
  // 100 requests/60s comfortably covers normal tool-calling traffic (each MCP
  // tool call is one request) while still capping a runaway client/retry loop.
  "ratelimits": [{ "name": "MCP_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 100, "period": 60 } }],

  // Surfaces which deployed Worker version is actually live via /health —
  // exactly the question we had no answer to while debugging the container
  // naming conflict (was the last deploy's code even the one running?).
  "version_metadata": { "binding": "CF_VERSION_METADATA" },

  // Durable store for the OAuth proxy (src/server/oauth.py, not yet
  // written): authorization codes, refresh tokens, and registered clients.
  // KV rather than D1 — every record here is a pure point-lookup by opaque
  // string, no relational queries, and KV's built-in per-key TTL lets a
  // short-lived authorization code expire itself with no cleanup job. Needed
  // because the Container's disk is wiped on every idle-sleep, so a refresh
  // token can't live in the same per-tenant SQLite file the personal-access-
  // token flow uses today — it would vanish on the next cold start.
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "afc28b10107f4fc591857970d92dc62c" }],

  // The landing page and privacy policy (worker/site, an Astro static site)
  // built to worker/site/dist — `npm run build:site` (package.json) builds
  // it; wrangler bundles whatever's in this directory at deploy time. A
  // request matching a file here is served directly, without ever invoking
  // src/index.ts's fetch handler (so it never wakes the container); anything
  // that doesn't match (/mcp, /health) falls through to the Worker as usual.
  "assets": { "directory": "./site/dist", "binding": "ASSETS" },

  // ynab.nyuchi.com is dedicated to this Worker (this MCP server plus its
  // landing/privacy-policy site), so it's a Custom Domain (this Worker is
  // the origin for the whole hostname, all paths) — Cloudflare manages the
  // DNS record and certificate automatically. If this subdomain ever needs
  // to serve anything else, switch this to a scoped Route instead
  // (`{ "pattern": "ynab.nyuchi.com/mcp*", "zone_name": "nyuchi.com" }`),
  // which requires its own proxied DNS record already at that hostname.
  "routes": [{ "pattern": "ynab.nyuchi.com", "custom_domain": true }],

  // Enabled in the dashboard (Settings -> Observability); mirrored here so a
  // future `wrangler deploy`/Workers Builds run doesn't silently reset it to
  // the default (disabled). head_sampling_rate: 1 means every request's logs
  // and traces are captured, not sampled — fine at this deployment's current
  // volume; revisit if usage grows enough that log volume/cost matters.
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
