{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mcp-ynab",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // The Dockerfile lives inside this directory (Cloudflare's Workers Builds
  // git-integration requires the Wrangler config and Dockerfile to both be
  // under the configured root directory — see README.md), but its COPY paths
  // (pyproject.toml, uv.lock, src/, README.md) are repo-root-relative, so the
  // build context is set to the repo root via image_build_context.
  "containers": [
    {
      "class_name": "YnabMcpContainer",
      "image": "./Dockerfile",
      "image_build_context": "..",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "class_name": "YnabMcpContainer", "name": "YNAB_MCP_CONTAINER" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["YnabMcpContainer"] }],

  // budget.bryanfawcett.com is dedicated to this MCP server, so it's a Custom
  // Domain (this Worker is the origin for the whole hostname, all paths) —
  // Cloudflare manages the DNS record and certificate automatically. If this
  // subdomain ever needs to serve anything besides /mcp and /health, switch
  // this to a scoped Route instead (`{ "pattern": "budget.bryanfawcett.com/mcp*",
  // "zone_name": "bryanfawcett.com" }`), which requires its own proxied DNS
  // record already at that hostname.
  "routes": [{ "pattern": "budget.bryanfawcett.com", "custom_domain": true }]
}
